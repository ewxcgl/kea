<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-app language selection. Android 13+ reads this for the system language
  picker; AppCompatDelegate.setApplicationLocales() drives it below 13.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
</locale-config>